{
  "note": "Example only. Do not use this file as live project config.",
  "providers": {
    "local": {
      "type": "openai",
      "baseURL": "http://localhost:8000/v1",
      "apiKey": "not-needed-local"
    }
  },
  "agents": {
    "thinking": {
      "provider": "local",
      "model": "thinking-alias",
      "temperature": 0.4,
      "maxTokens": 4096
    },
    "coding": {
      "provider": "local",
      "model": "coding-alias",
      "temperature": 0.1,
      "maxTokens": 4096
    },
    "research": {
      "provider": "local",
      "model": "research-alias",
      "temperature": 0.3,
      "maxTokens": 4096
    }
  }
}